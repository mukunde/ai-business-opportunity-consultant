# Copy to backend/.env and adjust as needed. Never commit the real .env.

ENVIRONMENT=development
DEBUG=true

# Interview engine LLM. Use "fake" to run the whole flow offline with a
# deterministic stub (no API key, no cost); switch to "claude" once you set
# ANTHROPIC_API_KEY below.
LLM_PROVIDER=fake
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-4-8

# Matches the docker-compose Postgres service. If port 5432 is already taken on
# your machine (e.g. a native Postgres), set POSTGRES_HOST_PORT in a root .env
# (e.g. 5433) and point DATABASE_URL at the same port.
DATABASE_URL=postgresql+psycopg://aiboc:aiboc@localhost:5432/aiboc
